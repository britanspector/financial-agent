# Optional: copy to .env. Process environment variables take precedence.
FINANCIAL_AGENT_LOG_LEVEL=INFO
# Only synthetic data is supported.
FINANCIAL_AGENT_DATA_MODE=synthetic
# Reserved for future model adapters; no key is needed in Phase 0.
FINANCIAL_AGENT_MODEL_API_KEY=
# Phase 1.1 local synthetic data paths.
FINANCIAL_AGENT_USER_DB_PATH=data/user_data.db
FINANCIAL_AGENT_AUDIT_PATH=data/audit.jsonl
# JSON array of {api_key, principal_id, user_ids, scopes}; empty denies all access.
# Populate only with locally generated test keys. See README for PowerShell example.
FINANCIAL_AGENT_USER_API_KEYS=[]
# Host-supplied caller key for the local CLI, never an Agent tool argument.
FINANCIAL_AGENT_CALLER_API_KEY=
# Tushare REST market data. Never commit a real token.
FINANCIAL_AGENT_TUSHARE_TOKEN=
FINANCIAL_AGENT_TUSHARE_BASE_URL=https://api.tushare.pro
FINANCIAL_AGENT_MARKET_DATA_TIMEOUT_SECONDS=10
# Multi-source RAG local corpus/index settings. Generated indexes are Git-ignored.
FINANCIAL_AGENT_KNOWLEDGE_MANIFEST_PATH=data/knowledge/manifest.json
FINANCIAL_AGENT_RAG_EMBEDDING_INDEX_PATH=data/knowledge/index/embeddings.npz
FINANCIAL_AGENT_RAG_CHUNK_MAX_CHARS=400
FINANCIAL_AGENT_RAG_RRF_K=60
# Qwen 3.7 retrieval providers. Never commit a real key.
FINANCIAL_AGENT_QWEN_API_KEY=
FINANCIAL_AGENT_QWEN_EMBEDDING_MODEL=qwen3.7-text-embedding
# Switch the model above to qwen3.7-text-embedding-flash for lower-cost indexing.
FINANCIAL_AGENT_QWEN_EMBEDDING_DIMENSION=1024
FINANCIAL_AGENT_QWEN_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/api/v1
FINANCIAL_AGENT_QWEN_RERANKER_MODEL=qwen3.7-text-rerank
FINANCIAL_AGENT_QWEN_RERANKER_BASE_URL=https://dashscope.aliyuncs.com/api/v1
FINANCIAL_AGENT_QWEN_TIMEOUT_SECONDS=30
# Phase 3.1 structured planner (uses FINANCIAL_AGENT_QWEN_API_KEY).
FINANCIAL_AGENT_PLANNER_MODEL=qwen3.7-flash-2026-07-15
FINANCIAL_AGENT_PLANNER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
FINANCIAL_AGENT_PLANNER_TIMEOUT_SECONDS=30
FINANCIAL_AGENT_PLANNER_TEMPERATURE=0.1
FINANCIAL_AGENT_PLANNER_MAX_TASKS=12
# Phase 4.2 structured verifier (uses FINANCIAL_AGENT_QWEN_API_KEY).
FINANCIAL_AGENT_VERIFIER_MODEL=qwen3.7-flash
FINANCIAL_AGENT_VERIFIER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
FINANCIAL_AGENT_VERIFIER_TIMEOUT_SECONDS=30
FINANCIAL_AGENT_VERIFIER_TEMPERATURE=0
# Phase 4.3 evidence-grounded Answer Writer and bounded Agent Loop.
FINANCIAL_AGENT_ANSWER_MODEL=qwen3.7-flash
FINANCIAL_AGENT_ANSWER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
FINANCIAL_AGENT_ANSWER_TIMEOUT_SECONDS=30
FINANCIAL_AGENT_ANSWER_TEMPERATURE=0.1
# Phase 5 context selection, stable summary, and local history retrieval. Budgets count history only.
FINANCIAL_AGENT_CONTEXT_STRATEGY=full_history
FINANCIAL_AGENT_CONTEXT_LAST_N=6
FINANCIAL_AGENT_CONTEXT_SUMMARY_RECENT_N=3
FINANCIAL_AGENT_CONTEXT_SUMMARY_BUDGET_RATIO=0.4
FINANCIAL_AGENT_CONTEXT_SUMMARY_CACHE_SIZE=128
FINANCIAL_AGENT_CONTEXT_SUMMARY_MAX_FACTS=24
FINANCIAL_AGENT_CONTEXT_RETRIEVAL_TOP_K=4
FINANCIAL_AGENT_CONTEXT_RETRIEVAL_MIN_SCORE=0.15
FINANCIAL_AGENT_CONTEXT_RETRIEVAL_RECENT_RESERVATION_RATIO=0.3
FINANCIAL_AGENT_CONTEXT_RETRIEVAL_PROTECTED_SUMMARY_RESERVATION_RATIO=0.1
FINANCIAL_AGENT_CONTEXT_RETRIEVAL_HISTORY_RESERVATION_RATIO=0.1
FINANCIAL_AGENT_PLANNER_CONTEXT_BUDGET_TOKENS=4096
FINANCIAL_AGENT_ANSWER_CONTEXT_BUDGET_TOKENS=4096
FINANCIAL_AGENT_VERIFIER_CONTEXT_BUDGET_TOKENS=4096
FINANCIAL_AGENT_SUMMARY_MODEL=qwen3.7-flash
FINANCIAL_AGENT_SUMMARY_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
FINANCIAL_AGENT_SUMMARY_TIMEOUT_SECONDS=30
FINANCIAL_AGENT_SUMMARY_TEMPERATURE=0
FINANCIAL_AGENT_LOOP_MAX_REWRITE=2
FINANCIAL_AGENT_LOOP_MAX_REPLAN=2
FINANCIAL_AGENT_LOOP_MAX_ITERATIONS=5
FINANCIAL_AGENT_LOOP_TOTAL_TOOL_BUDGET=36
# Phase 4.1 execution retry. Deadline only prevents starting a new Tool attempt.
FINANCIAL_AGENT_EXECUTION_MAX_RETRY=2
FINANCIAL_AGENT_EXECUTION_INITIAL_BACKOFF_SECONDS=0.5
FINANCIAL_AGENT_EXECUTION_BACKOFF_MULTIPLIER=2
FINANCIAL_AGENT_EXECUTION_MAX_ATTEMPTS=36
FINANCIAL_AGENT_EXECUTION_DEADLINE_SECONDS=120
